# 生产环境配置模板。复制为 .env.production 后填写；该文件不要提交到仓库。
# 密钥类配置建议放腾讯云 SSM 凭据管理，部署时由脚本拉取写入。

NODE_ENV=production
PORT=3000
# 平台对外地址（CLB 绑定的域名）
PUBLIC_BASE_URL=https://defects.example.com
WEB_ORIGIN=https://defects.example.com

# TencentDB for PostgreSQL（内网地址）
DATABASE_URL=postgresql://defect:<密码>@10.0.0.10:5432/defect?sslmode=prefer

# 用 `openssl rand -base64 48` 生成
JWT_SECRET=
JWT_EXPIRES_IN=12h

STORAGE_DRIVER=cos
# CAM 子账号 defect-platform（方案 5.4 ②）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=feedback-1250000000
COS_REGION=ap-guangzhou
COS_APPID=1250000000

# 与 SCF 转发函数共享，用 `openssl rand -hex 32` 生成
INGEST_HMAC_SECRET=
RECONCILE_INTERVAL_MINUTES=10
RUN_WORKER=true

# 首次部署初始化的系统管理员（migrate 服务执行 seed 时使用；已存在则跳过）
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=管理员
