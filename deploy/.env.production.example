# 生产环境配置模板。复制为 .env.production 后填写；该文件不要提交到仓库。
# 密钥类配置建议放腾讯云 SSM 凭据管理，部署时由脚本拉取写入。

NODE_ENV=production
PORT=3000
# 平台对外地址（CLB 绑定的域名）
PUBLIC_BASE_URL=https://defects.example.com
WEB_ORIGIN=https://defects.example.com

# TencentDB for PostgreSQL（内网地址）。账号需要能执行 CREATE EXTENSION pg_trgm（模糊搜索用）
DATABASE_URL=postgresql://defect:<密码>@10.0.0.10:5432/defect?sslmode=prefer
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000

# 用 `openssl rand -base64 48` 生成
JWT_SECRET=
JWT_EXPIRES_IN=12h

# 请求链路：浏览器 → CLB → web 容器（nginx）→ server，两层代理；用来取真实客户端 IP 做限流
TRUST_PROXY_HOPS=2
# RATE_LIMIT_PER_MINUTE=600
# AUTH_RATE_LIMIT_PER_MINUTE=10

# 附件存储：推荐 cos。没有 COS 时改为 local，附件存在 server 容器的数据卷 server-data 里（需自行备份）
STORAGE_DRIVER=cos
# CAM 子账号 defect-platform（方案 5.4 ②）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=feedback-1250000000
COS_REGION=ap-guangzhou
COS_APPID=1250000000
# STORAGE_DRIVER=local 时必填，用 `openssl rand -hex 32` 生成
# LOCAL_STORAGE_SECRET=

# 是否在本进程内运行后台任务（录屏抽帧、清理等）
RUN_WORKER=true

# 首次部署初始化的系统管理员（migrate 服务执行 seed 时使用；已存在则跳过）
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=管理员

# ---- 以下只给 docker compose 用，服务端不读取 ----
# 网页对外端口（CLB 转发到这个端口）
WEB_PORT=80
# 镜像仓库与版本：在 CVM 上构建时保持默认；从腾讯云 TCR 拉取时改成仓库地址，如
# IMAGE_REGISTRY=ccr.ccs.tencentyun.com/<命名空间>
IMAGE_REGISTRY=defect
IMAGE_TAG=latest
# 国内构建镜像源（在 CVM 或 CI 上构建时用，可不填）
NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
# Debian 源：CVM 内网源（只在腾讯云内可用）；在腾讯云外构建改为 http://mirrors.aliyun.com 或留空
DEBIAN_MIRROR=http://mirrors.tencentyun.com
FFMPEG_BINARIES_URL=https://registry.npmmirror.com/-/binary/ffmpeg-static
