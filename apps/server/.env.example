# ---- 基础 ----
NODE_ENV=development
PORT=3000
# 对外访问地址（生成预签名链接、MCP 文档中使用）
PUBLIC_BASE_URL=http://localhost:3000
# 前端地址，用于 CORS
WEB_ORIGIN=http://localhost:5173

# ---- 数据库 ----
# 本地开发：npm run db:start 启动嵌入式 PostgreSQL（端口 5433）
DATABASE_URL=postgresql://defect:defect@localhost:5433/defect

# ---- 鉴权 ----
# 生产环境务必替换为 32 位以上随机串
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---- 对象存储 ----
# local：附件存本机 .data/storage（开发用）；cos：腾讯云 COS
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=../../.data/storage
# 本地存储签名链接用的密钥
LOCAL_STORAGE_SECRET=change-me-local-storage

# STORAGE_DRIVER=cos 时必填：平台专用 CAM 子账号 defect-platform（方案 5.4 ②）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_APPID=

# ---- APP 反馈接入 ----
# COS 事件转发（SCF → 平台）的 HMAC 共享密钥（方案 5.4 ③）
INGEST_HMAC_SECRET=change-me-ingest-secret
# 定时对账间隔（分钟），0 表示关闭
RECONCILE_INTERVAL_MINUTES=10
# 是否在本进程内运行后台任务（多实例部署时只开一个或独立部署 worker）
RUN_WORKER=true

# ---- 在线更新（仅 macOS / Linux 上的 pm2 单机部署，见 docs/deploy-single-host.md）----
# SELF_UPDATE=true
# UPDATE_REMOTE=origin
# UPDATE_BRANCH=main
# UPDATE_CHECK_INTERVAL_MINUTES=60
