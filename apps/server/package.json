{
  "name": "@defect/server",
  "version": "0.1.0",
  "private": true,
  "description": "缺陷平台服务端：REST API、APP 反馈建单、MCP Server",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "tsx scripts/dev-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@defect/shared": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "ffmpeg-static": "^5.3.0",
    "pg": "^8.16.3",
    "qcloud-cos-sts": "^3.1.3",
    "re2js": "^2.8.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.4",
    "yauzl": "^3.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^2.10.3",
    "dotenv": "^17.2.3",
    "embedded-postgres": "^18.0.0-beta.15",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
